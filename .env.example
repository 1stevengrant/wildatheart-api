# Non secret settings default to their production values in config/, so only
# local overrides and secrets belong here. Leave a key out rather than blank:
# an empty value overrides the config default.

APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://wahfires.test

DB_DATABASE=wahlocal

QUEUE_CONNECTION=redis
SESSION_DRIVER=file

# Flock catches mail on 127.0.0.1:2525 (the config default). Production uses
# failover (Cloudflare first, then SendGrid over SMTP); previews use log.
MAIL_MAILER=smtp
CLOUDFLARE_EMAIL_API_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WP_AWS_ACCESS_KEY_ID=
WP_AWS_SECRET_ACCESS_KEY=

AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

MAPBOX_API_KEY=
VITE_REACT_APP_MAPBOX_TOKEN=

ZENDESK_TOKEN=
ZENDESK_USERNAME=

SENTRY_LARAVEL_DSN=
VITE_SENTRY_LARAVEL_DSN=

NIGHTWATCH_ENABLED=true
NIGHTWATCH_TOKEN=

SLACK_WEBHOOK_URL=
SLACK_EVENTS_WEBHOOK_URL=
FAILED_JOB_MONITOR_SLACK=

STATAMIC_LICENSE_KEY=

SUBSPLASH_CLIENT_ID=
SUBSPLASH_CLIENT_SECRET=

TRANSISTOR_API_KEY=

WEGIVE_API_KEY=

# POST URL for the rebuild hook Worker (secret is the path)
# https://wildatheart-rebuild-hook.<subdomain>.workers.dev/<REBUILD_HOOK_SECRET>
CLOUDFLARE_ASTRO_BUILD_HOOK=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_REDIRECTS_ID=

# php artisan db:production-sync (needs mydumper, see the README). Credentials come from
# `cloud database-cluster:list --json --show-sensitive -n`
REMOTE_DATABASE_HOST=
REMOTE_DATABASE_USERNAME=
REMOTE_DATABASE_PASSWORD=

DRUPAL_DB_PASSWORD=
DRUPAL_DB_USERNAME=
DRUPAL_DB_DATABASE=
