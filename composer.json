{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-libxml": "*",
        "artesaos/seotools": "^1.3",
        "auth0/auth0-php": "^8.17",
        "eminos/statamic-tabs": "^1.2",
        "fakerphp/faker": "^1.23",
        "ghijk/laravel-email-preview": "^1.0",
        "ghijk/statamic-typescript-generator": "*@dev",
        "ghijk/wild-at-heart": "*@dev",
        "inertiajs/inertia-laravel": "^2.0",
        "jacksleight/statamic-bard-texstyle": "^3.4",
        "ksubileau/color-thief-php": "^2.0",
        "laravel/framework": "^11.31",
        "laravel/horizon": "^5.29",
        "laravel/nightwatch": "^1.7",
        "laravel/pail": "^1.1",
        "laravel/pennant": "^1.19",
        "laravel/pulse": "^1.2",
        "laravel/slack-notification-channel": "^3.5",
        "laravel/tinker": "^2.9",
        "laravolt/avatar": "^5.1",
        "league/csv": "^9.15",
        "league/flysystem-aws-s3-v3": "^3.0",
        "lorisleiva/laravel-actions": "^2.8",
        "ndx/statamic-bard-color-picker": "^2.0",
        "repat/laravel-validator-emojis": "^0.3.0",
        "saloonphp/laravel-plugin": "^3.0",
        "saloonphp/pagination-plugin": "^2.2",
        "saloonphp/rate-limit-plugin": "^2.1",
        "saloonphp/saloon": "^3.0",
        "sentry/sentry-laravel": "^4.10",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-data": "^3.1",
        "spatie/laravel-failed-job-monitor": "^4.3",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-ray": "^1.36",
        "spatie/laravel-slack-alerts": "^1.2",
        "spatie/laravel-typescript-transformer": "^2.5",
        "spatie/typescript-transformer": "^2.3",
        "squirephp/countries-en": "^3.5",
        "statamic-rad-pack/runway": "^8.3",
        "statamic/cms": "^5.6",
        "statamic/eloquent-driver": "^4.0",
        "stevebauman/purify": "^6.2",
        "symfony/http-client": "^7.0",
        "symfony/postmark-mailer": "^7.0",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.10",
        "barryvdh/laravel-ide-helper": "^3.0",
        "driftingly/rector-laravel": "^2.1",
        "laravel/boost": "^1.8",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.2",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "files": [
            "app/Support/helpers.php",
            "app/Support/images.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan horizon\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,horizon,logs,vite --kill-others"
        ],
        "pre-update-cmd": [
            "Statamic\\Console\\Composer\\Scripts::preUpdateCmd"
        ],
        "test": [
            "php artisan config:clear",
            "pest --parallel --processes=8",
            "php artisan test:cleanup-databases --force"
        ],
        "test:sequential": [
            "php artisan config:clear",
            "pest",
            "php artisan test:cleanup-databases --force"
        ],
        "test:fast": [
            "php artisan config:clear",
            "pest --parallel --processes=8 --no-coverage"
        ],
        "test:unit": [
            "pest tests/Unit"
        ],
        "test:feature": [
            "pest tests/Feature --parallel --processes=4"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan statamic:install --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "addons/ghijk/wild-at-heart"
        },
        {
            "type": "path",
            "url": "addons/ghijk/statamic-typescript-generator"
        },
        {
            "type": "path",
            "url": "packages/laravel-email-preview"
        }
    ]
}
