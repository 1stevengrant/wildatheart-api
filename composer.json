{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "artesaos/seotools": "^1.3",
        "auth0/auth0-php": "8.14.0",
        "fakerphp/faker": "^1.23",
        "ghijk/wild-at-heart": "*@dev",
        "inertiajs/inertia-laravel": "^2.0",
        "jacksleight/statamic-bard-texstyle": "^3.4",
        "ksubileau/color-thief-php": "^2.0",
        "laravel/framework": "^11.31",
        "laravel/horizon": "^5.29",
        "laravel/nightwatch": "^1.7",
        "laravel/pail": "^1.1",
        "laravel/pulse": "^1.2",
        "laravel/slack-notification-channel": "^3.5",
        "laravel/tinker": "^2.9",
        "laravolt/avatar": "^5.1",
        "league/csv": "^9.15",
        "league/flysystem-aws-s3-v3": "^3.0",
        "lorisleiva/laravel-actions": "^2.8",
        "ndx/statamic-bard-color-picker": "^2.0",
        "repat/laravel-validator-emojis": "^0.3.0",
        "saloonphp/laravel-plugin": "^3.0",
        "saloonphp/saloon": "^3.0",
        "sentry/sentry-laravel": "^4.10",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-data": "^3.1",
        "spatie/laravel-failed-job-monitor": "^4.3",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-ray": "^1.36",
        "spatie/laravel-slack-alerts": "^1.2",
        "spatie/laravel-typescript-transformer": "^2.5",
        "spatie/typescript-transformer": "^2.3",
        "squirephp/countries-en": "^3.5",
        "statamic-rad-pack/runway": "^8.3",
        "statamic/cms": "^5.6",
        "statamic/eloquent-driver": "^4.17",
        "stevebauman/purify": "^6.2",
        "symfony/http-client": "^7.0",
        "symfony/postmark-mailer": "^7.0",
        "tightenco/ziggy": "v2.0.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.10",
        "barryvdh/laravel-ide-helper": "^3.0",
        "laravel/boost": "^1.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-faker": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "files": [
            "app/Support/helpers.php",
            "app/Support/images.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-update-cmd": [
            "Statamic\\Console\\Composer\\Scripts::preUpdateCmd"
        ],
        "test": [
            "php artisan config:clear",
            "pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan statamic:install --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "addons/ghijk/wild-at-heart"
        }
    ]
}
