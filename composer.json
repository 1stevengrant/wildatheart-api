{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "alexazartsev/heroicon": "^2.0",
        "algolia/algoliasearch-client-php": "^3.4",
        "algolia/scout-extended": "^3.0",
        "artesaos/seotools": "^1.2",
        "auth0/auth0-php": "^8.7",
        "eminiarts/nova-tabs": "^2.2",
        "fakerphp/faker": "^1.22",
        "geoip2/geoip2": "^2.13",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^0.6.10",
        "intervention/image": "^2.7",
        "laravel/framework": "^10.9",
        "laravel/nova": "^4.3",
        "laravel/sanctum": "^3.2",
        "laravel/scout": "^10.2",
        "laravel/tinker": "^2.8",
        "laravel/vapor-core": "^2.32",
        "league/flysystem-aws-s3-v3": "^3.0",
        "lorisleiva/laravel-actions": "^2.5",
        "omniphx/forrest": "2.*",
        "repat/laravel-validator-emojis": "^0.2.0",
        "sentry/sentry-laravel": "^3.4",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-failed-job-monitor": "^4.2",
        "spatie/laravel-glide": "^3.7",
        "spatie/laravel-permission": "^5.10",
        "spatie/laravel-ray": "^1.36",
        "spatie/laravel-slack-alerts": "^1.2",
        "squirephp/countries-en": "^3.4",
        "stepanenko3/nova-command-runner": "^4.3",
        "symfony/http-client": "^6.3",
        "symfony/postmark-mailer": "^6.3",
        "tightenco/ziggy": "^1.6",
        "vyuldashev/nova-permission": "^3.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.8",
        "barryvdh/laravel-ide-helper": "^2.13",
        "kitloong/laravel-migrations-generator": "^6.10",
        "laravel/breeze": "^1.21",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "pestphp/pest": "^2.6",
        "pestphp/pest-plugin-drift": "^2.3",
        "pestphp/pest-plugin-faker": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "files": [
            "app/Support/helpers.php",
            "app/Support/images.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ]
}
