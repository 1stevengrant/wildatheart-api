{
    "name": "wild-at-heart/local",
    "type": "project",
    "description": "Wild at Heart Local platform for connecting community members to events worldwide.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-libxml": "*",
        "artesaos/seotools": "^1.3",
        "auth0/auth0-php": "^8.17",
        "aws/aws-sdk-php": "^3.398",
        "fakerphp/faker": "^1.23",
        "ghijk/laravel-email-preview": "^1.0",
        "ghijk/statamic-typescript-generator": "*@dev",
        "inertiajs/inertia-laravel": "^2.0",
        "jacksleight/statamic-bard-texstyle": "^4.0",
        "ksubileau/color-thief-php": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/nightwatch": "^1.7",
        "laravel/pail": "^1.1",
        "laravel/pennant": "^1.19",
        "laravel/slack-notification-channel": "^3.5",
        "laravel/tinker": "^3.0",
        "laravolt/avatar": "^6.0",
        "league/csv": "^9.15",
        "league/flysystem-aws-s3-v3": "^3.0",
        "lorisleiva/laravel-actions": "^2.8",
        "ndx/statamic-bard-color-picker": "^3.0",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/pagination-plugin": "^2.2",
        "saloonphp/rate-limit-plugin": "^2.1",
        "saloonphp/saloon": "^4.0",
        "sentry/sentry-laravel": "^4.10",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-failed-job-monitor": "^4.3",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-ray": "^1.36",
        "spatie/laravel-slack-alerts": "^1.2",
        "spatie/laravel-typescript-transformer": "^2.5",
        "spatie/typescript-transformer": "^2.3",
        "squirephp/countries-en": "^3.5",
        "statamic-rad-pack/runway": "^9.0",
        "statamic/cms": "^6.20.3",
        "statamic/eloquent-driver": "^5.0",
        "stevebauman/purify": "^6.2",
        "symfony/http-client": "^7.0",
        "tightenco/ziggy": "^2.6",
        "toitzi/laravel-cloudflare-mail": "^1.0",
        "wild-at-heart/command-center": "*@dev"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.0",
        "driftingly/rector-laravel": "^2.1",
        "laravel/boost": "^2.0",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.2",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "files": [
            "app/Support/helpers.php",
            "app/Support/images.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "@dev:types",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@dev:types",
            "npx concurrently -k -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#86efac\" -n vite,queue,logs,scheduler --kill-others \"npm run dev\" \"php artisan queue:listen --queue=default,mail --tries=1 --timeout=150\" \"php artisan pail --timeout=0\" \"php artisan schedule:work\""
        ],
        "pre-update-cmd": [
            "Statamic\\Console\\Composer\\Scripts::preUpdateCmd"
        ],
        "test": [
            "php artisan config:clear",
            "pest --parallel --processes=8",
            "php artisan test:cleanup-databases --force"
        ],
        "test:sequential": [
            "php artisan config:clear",
            "pest",
            "php artisan test:cleanup-databases --force"
        ],
        "test:fast": [
            "php artisan config:clear",
            "php artisan route:clear",
            "pest --parallel --processes=8 --no-coverage",
            "php artisan test:cleanup-databases --force"
        ],
        "test:comparison": [
            "php artisan config:clear",
            "pest tests/Parity --group=comparison"
        ],
        "test:unit": [
            "pest tests/Unit"
        ],
        "test:feature": [
            "pest tests/Feature --parallel --processes=4",
            "php artisan test:cleanup-databases --force"
        ],
        "dev:types": [
            "@php artisan statamic:generate-types --skip-pint",
            "@php artisan typescript:transform"
        ],
        "rector": "rector process",
        "rector:dry": "rector process --dry-run",
        "refactor": [
            "@rector",
            "pint"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan statamic:install --ansi --no-cache-clear"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "addons/ghijk/statamic-typescript-generator"
        },
        {
            "type": "path",
            "url": "packages/laravel-email-preview"
        },
        {
            "type": "path",
            "url": "addons/wild-at-heart/command-center"
        }
    ]
}
