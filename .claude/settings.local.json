{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(php artisan test:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(php artisan typescript:transform:*)"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ]
}
