{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(php artisan test:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc:*)",
      "Bash(php artisan typescript:transform:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint)",
      "Bash(npx eslint:*)",
      "Bash(php artisan:*)",
      "mcp__laravel-boost__tinker",
      "Bash(php artisan statamic:stache:clear:*)",
      "Bash(php artisan:*)",
      "Bash(php artisan config:clear:*)",
      "Bash(php artisan view:clear:*)",
      "mcp__laravel-boost__get-absolute-url",
      "Bash(cat:*)",
      "Bash(curl:*)",
      "Bash(composer install:*)",
      "Bash(composer update:*)",
      "Bash(find:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(php -l:*)"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ]
