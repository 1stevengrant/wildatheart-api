{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(php artisan test:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(php artisan typescript:transform:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint)",
      "Bash(npx eslint:*)",
      "Bash(php artisan:*)",
      "mcp__laravel-boost__read-log-entries"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ]
}