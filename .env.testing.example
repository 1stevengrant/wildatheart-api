APP_NAME="Wild at Heart Fires"
APP_ENV=testing
APP_KEY= #Run: php artisan key:generate
APP_DEBUG=true
APP_URL= #REPLACE WITH YOUR URL

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wahlocal_test
DB_USERNAME=root

AWS_ACCESS_KEY_ID= #REPLACE WITH YOUR AWS ACCESS KEY ID
AWS_SECRET_ACCESS_KEY= #REPLACE WITH YOUR AWS SECRET ACCESS KEY
AWS_DEFAULT_REGION= #REPLACE WITH YOUR AWS REGION
AWS_BUCKET= #REPLACE WITH YOUR AWS BUCKET
AWS_USE_PATH_STYLE_ENDPOINT=false
