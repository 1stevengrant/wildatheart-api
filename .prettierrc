{
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": false,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "*.{yml,yaml,docker-compose.yml}",
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "docker-compose.yml",
            "options": {
                "tabWidth": 4
            }
        }
    ]
}
