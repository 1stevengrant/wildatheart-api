{
    "name": "ghijk/statamic-typescript-generator",
    "description": "Generate TypeScript definitions from Statamic blueprints",
    "type": "statamic-addon",
    "keywords": [
        "statamic",
        "typescript",
        "blueprints",
        "code-generation"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ghijk\\StatamicTypescriptGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ghijk\\StatamicTypescriptGenerator\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.0"
    },
    "extra": {
        "statamic": {
            "name": "Statamic TypeScript Generator",
            "description": "Generate TypeScript definitions from Statamic blueprints"
        },
        "laravel": {
            "providers": [
                "Ghijk\\StatamicTypescriptGenerator\\ServiceProvider"
            ]
        }
    }
}
